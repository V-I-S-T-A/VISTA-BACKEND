DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Railway Hobby: send through HTTPS instead of blocked SMTP ports.
EMAIL_BACKEND=vista.email_backend.ResendEmailBackend
RESEND_API_KEY=replace-with-your-resend-api-key
DEFAULT_FROM_EMAIL=VISTA <no-reply@your-verified-domain.example>
EMAIL_TIMEOUT=15
# Frontend base URL used for email links and Google Drive return redirects.
# For local development, use http://localhost:5173 instead.
FRONTEND_URL=https://vista-web-production-4086.up.railway.app

# Google Drive OAuth: use credentials from the same Google Cloud web client.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Must exactly match the Authorized redirect URI in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=https://vista-backend-production-10d7.up.railway.app/api/drive/auth/callback/

# Alternative for Railway Hobby without a custom sender domain (GMAIL_API.md):
# EMAIL_BACKEND=vista.gmail_backend.GmailAPIEmailBackend
# GMAIL_API_CLIENT_ID=your-email-oauth-client-id
# GMAIL_API_CLIENT_SECRET=your-email-oauth-client-secret
# GMAIL_API_REFRESH_TOKEN=your-sender-refresh-token
# DEFAULT_FROM_EMAIL=VISTA <your-authorized-account@gmail.com>
