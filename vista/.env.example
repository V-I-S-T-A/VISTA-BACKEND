DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# SMTP requires Railway Pro or above. Redeploy after upgrading.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=replace-with-your-google-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=VISTA <your-account@gmail.com>
EMAIL_TIMEOUT=15
